# Little Steps - Environment Configuration
# Copy this file to .env and fill in your values
# For local XAMPP development, you can leave DB_PASS empty

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=littlesteps_db
DB_PORT=3306

# Site URL (optional - auto-detected if not set)
# SITE_URL=https://yourdomain.com

# For Railway/Cloud deployment, use these instead:
# MYSQLHOST=your-railway-mysql-host
# MYSQLUSER=your-railway-mysql-user
# MYSQLPASSWORD=your-railway-mysql-password
# MYSQLDATABASE=your-railway-mysql-database
# MYSQLPORT=3306